; A text chamber_cooled_temp is refused at START instead of stranding the loop.
SET_GCODE_VARIABLE MACRO=_COOLDOWN_VARS VARIABLE=chamber_cooled_temp VALUE="'35'"
START_COOLDOWN PROFILE=HOLD_60M_COOL_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=0
SET_GCODE_VARIABLE MACRO=_COOLDOWN_VARS VARIABLE=chamber_cooled_temp VALUE=-50
START_COOLDOWN PROFILE=HOLD_60M_COOL_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=1
COOLDOWN_RESET

CHAMBER TEMP=45
SET_GCODE_VARIABLE MACRO=_COOLDOWN_VARS VARIABLE=chamber_cooled_temp VALUE=-50
START_COOLDOWN PROFILE=HOLD_120M_COOL_NO_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=idle_timeout_extended VALUE=1
; Shorten the hold to one loop and step the ramp every loop.
SET_GCODE_VARIABLE MACRO=_COOLDOWN_VARS VARIABLE=hold_loops VALUE=1
SET_GCODE_VARIABLE MACRO=_COOLDOWN_VARS VARIABLE=ramp_step_loops VALUE=1
TEST_COOLDOWN_TICK
TEST_COOLDOWN_TICK
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=2
TEST_COOLDOWN_TICK
ASSERT_HEATER HEATER=heater_generic:chamber TARGET=44
TEST_COOLDOWN_TICK
TEST_COOLDOWN_TICK
ASSERT_HEATER HEATER=heater_generic:chamber TARGET=42
TEST_COOLDOWN_TICK
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=3
ASSERT_HEATER HEATER=heater_generic:chamber TARGET=0
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=idle_timeout_extended VALUE=0
COOLDOWN_RESET

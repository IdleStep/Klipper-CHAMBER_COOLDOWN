; idle_timeout_tracking.cfg renames SET_IDLE_TIMEOUT, which only real firmware can check.
; The script cannot read the timeout in force, so it checks the variables the wrapper keeps.
SET_GCODE_VARIABLE MACRO=_COOLDOWN_VARS VARIABLE=chamber_cooled_temp VALUE=-50
SET_IDLE_TIMEOUT TIMEOUT=2000
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=user_idle_timeout VALUE=2000.0
CHAMBER TEMP=55
START_COOLDOWN PROFILE=HOLD_120M_COOL_NO_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=idle_timeout_extended VALUE=1
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=extended_idle_timeout VALUE=9360.0
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=user_idle_timeout VALUE=2000.0
SET_IDLE_TIMEOUT TIMEOUT=1000
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=user_idle_timeout VALUE=1000.0
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=idle_timeout_extended VALUE=1
COOLDOWN_RESET
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=idle_timeout_extended VALUE=0
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=extended_idle_timeout VALUE=0.0
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=user_idle_timeout VALUE=1000.0
SET_IDLE_TIMEOUT TIMEOUT=999999
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=user_idle_timeout VALUE=999999.0
START_COOLDOWN PROFILE=HOLD_120M_COOL_NO_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=idle_timeout_extended VALUE=0
COOLDOWN_RESET
